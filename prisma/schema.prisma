generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id              String   @id @default(uuid()) // <-- changed from Int to String UUID
  role            Role     @default(user)
  name            String
  email           String   @unique
  password        String
  avatarUrl       String?
  avatarPublicId  String?
  isEmailVerified Boolean   @default(false)
  phone           String?
  address         String?
  deletedAt       DateTime? @db.Timestamp(6)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("user")
}

model OTP {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otp")
}

/*
  Media model converted from your Mongoose schema.
  - required fields: asset_id, public_id, path, thumbnail, thumbnail_url
  - optional fields: alt, title
  - deletedAt is nullable and indexed
*/


model Media {
  id            String    @id @default(uuid())
  asset_id      String
  public_id     String
  path          String
  thumbnail     String?
  thumbnail_url String
  secure_url    String
  alt           String? 
  title         String?
  productId     String?          // ✅ product relation (nullable so existing media won't break)
  product       Product?         @relation(fields: [productId], references: [id])
  categoryId    String?          // ✅ category relation (nullable so existing media won't break)
  category      Category?        @relation(fields: [categoryId], references: [id])
  subCategoryId String?          // ✅ subcategory relation (nullable so existing media won't break)
  subCategory   SubCategory?     @relation(fields: [subCategoryId], references: [id])

  deletedAt     DateTime? @db.Timestamp(6)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("medias")
  @@index([deletedAt], map: "idx_medias_deleted_at")
  @@index([productId], map: "idx_medias_product_id") // ✅ optional index for faster queries
  @@index([categoryId], map: "idx_medias_category_id") // ✅ optional index for faster queries
  @@index([subCategoryId], map: "idx_medias_subcategory_id") // ✅ optional index for faster queries
}



//categories model

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  deletedAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Many-to-Many: One Category can have many SubCategories via junction table
  categorySubCategories CategorySubCategory[]
  
  // One Category can have many Media (but we'll use only one)
  media         Media[]
  
  // One Category can have many Products
  products      Product[]

  @@map("categories") // table name
  @@index([deletedAt], map: "idx_categories_deleted_at")
}


model SubCategory {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  deletedAt   DateTime?     @db.Timestamp(6)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Many-to-Many: One SubCategory can belong to many Categories via junction table
  categorySubCategories CategorySubCategory[]

  // One SubCategory has many Products
  products    Product[]

  // One SubCategory can have many Media (for images)
  media       Media[]

  @@map("sub_categories")
  @@index([deletedAt], map: "idx_subcategories_deleted_at")
}

// Junction table for many-to-many relationship between Category and SubCategory
model CategorySubCategory {
  id            String      @id @default(uuid())
  categoryId    String
  subCategoryId String
  
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([categoryId, subCategoryId]) // Prevent duplicate relationships
  @@map("category_subcategory")
  @@index([categoryId], map: "idx_cat_subcat_category_id")
  @@index([subCategoryId], map: "idx_cat_subcat_subcategory_id")
}

enum Gender {
  MEN
  WOMEN
}


model Product {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])
  subCategoryId   String
  subCategory     SubCategory  @relation(fields: [subCategoryId], references: [id])
  gender          Gender
  description     String        // ✅ new field (required)
  
  // One Product has many Media
  media           Media[]       // ✅ new relation

  // One Product has many Variants
  variants        ProductVariant[]

  deletedAt       DateTime?     @db.Timestamp(6)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("products")
  @@index([categoryId], map: "idx_products_category_id")
  @@index([subCategoryId], map: "idx_products_subcategory_id")
  @@index([deletedAt], map: "idx_products_deleted_at")
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  weight          Float
  purity          String   // e.g., "22K"
  size            String?  // e.g., "12" - for rings
  length          String?  // e.g., "18 inches" - for chains/mangalsutra
  
  // Pricing & Charges
  gst             Float
  labourCharge    Float
  hallmarkCharges Float
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("product_variants")
  @@index([productId], map: "idx_product_variants_product_id")
  @@unique([productId, weight, purity, size], map: "idx_product_variants_unique")
}

model MetalRate {
  id            String   @id @default(uuid())
  categoryName  String   // "Gold", "Silver", "Diamond" - matches Category.name
  purity        String   // "22K", "24K", "18K", "92.5"
  ratePerGram   Float    // Daily rate per gram
  updatedBy     String?  // Optional: admin user ID who updated
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([categoryName, purity], map: "idx_metal_rates_unique")
  @@map("metal_rates")
}

