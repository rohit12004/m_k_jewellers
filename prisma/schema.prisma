generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id              String   @id @default(uuid()) // <-- changed from Int to String UUID
  role            Role     @default(user)
  name            String
  email           String   @unique
  password        String
  avatarUrl       String?
  avatarPublicId  String?
  isEmailVerified Boolean   @default(false)
  phone           String?
  address         String?
  deletedAt       DateTime? @db.Timestamp(6)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("user")
}

model OTP {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otp")
}

/*
  Media model converted from your Mongoose schema.
  - required fields: asset_id, public_id, path, thumbnail, thumbnail_url
  - optional fields: alt, title
  - deletedAt is nullable and indexed
*/
model Media {
  id            String    @id @default(uuid())
  asset_id      String
  public_id     String
  path          String
  thumbnail     String?
  thumbnail_url String
  secure_url    String
  alt           String? 
  title         String?
  deletedAt     DateTime? @db.Timestamp(6)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("medias")
  @@index([deletedAt], map: "idx_medias_deleted_at")
}


//categories model

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  deletedAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

   // Relation: One Category has many SubCategories
  subcategories SubCategory[]

  @@map("categories") // table name
  @@index([deletedAt], map: "idx_categories_deleted_at")
}


model SubCategory {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  deletedAt   DateTime?     @db.Timestamp(6)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relation: many SubCategories belong to one Category
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])

  // One SubCategory has many Products
  products    Product[]

  @@map("sub_categories")
  @@index([categoryId], map: "idx_subcategories_category_id")
  @@index([deletedAt], map: "idx_subcategories_deleted_at")
}


model Product {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  subCategoryId  String
  subCategory    SubCategory  @relation(fields: [subCategoryId], references: [id])
  weight         Float
  gst            Float
  labourCharge   Float
  purityFactor   Float       // new: purity of the metal (e.g., 22 for 22K)
  hallmarkCharges Float      // new: hallmarking cost
  deletedAt      DateTime?   @db.Timestamp(6)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("products")
  @@index([subCategoryId], map: "idx_products_subcategory_id")
  @@index([deletedAt], map: "idx_products_deleted_at")
}
